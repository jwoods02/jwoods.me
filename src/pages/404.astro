---
import Base from "../layouts/Base.astro";
---

<Base title="404 — Page not found" description="The page you're looking for doesn't exist.">
  <div class="min-h-screen bg-white text-stone-900 flex items-center justify-center px-6">
    <div class="text-center">
      <p class="text-sm font-mono text-stone-500 uppercase tracking-widest mb-4">
        404
      </p>
      <h1 class="text-2xl font-semibold mb-2">Page not found</h1>
      <p class="text-stone-500 mb-8">
        The page you're looking for doesn't exist.
      </p>
      <a
        href="/"
        class="text-sm font-mono text-slate-400 hover:text-stone-900 transition-colors"
      >
        &larr; Back to home
      </a>
    </div>
  </div>
</Base>
