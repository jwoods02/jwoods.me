---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";

const entry = await getEntry("home", "index");
if (!entry) throw new Error("Could not find home page content");
const { data: site } = entry;
const { Content } = await render(entry);
---

<Base
    title={`${site.title} — Software Engineer`}
    description={`${site.title} — ${site.subtitle}. ${site.tagline}`}
>
    <div class="min-h-screen bg-white text-stone-900">
        <!-- Hero -->
        <section
            class="flex flex-col items-center justify-center min-h-[50vh] px-6 overflow-hidden"
        >
            <div class="max-w-4xl text-center">
                <h1
                    class="text-5xl md:text-7xl font-mono font-semibold tracking-tight leading-none text-stone-900"
                >
                    <span class="typewriter">{site.title}</span>
                </h1>
            </div>
            <p
                class="mt-6 text-lg md:text-xl text-stone-500 max-w-xl text-center font-sans leading-relaxed"
            >
                {site.subtitle}
            </p>
            <p
                class="mt-3 text-base md:text-lg text-stone-500 max-w-2xl text-center font-sans leading-relaxed"
            >
                {site.tagline}
            </p>
            <div class="flex gap-6 mt-8">
                {
                    site.links.map((link) => (
                        <a
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-sm font-mono text-stone-500 hover:text-slate-400 transition-colors"
                        >
                            {link.label} ↗
                        </a>
                    ))
                }
            </div>
        </section>

        <!-- About -->
        <section class="fade-in-section max-w-2xl mx-auto px-6 py-14">
            <h2
                class="text-sm font-mono text-stone-500 uppercase tracking-widest mb-6"
            >
                About
            </h2>
            <div
                class="text-stone-700 leading-relaxed [&>p]:mt-4 [&>p:first-child]:mt-0 [&_strong]:text-stone-900 [&_strong]:font-medium"
            >
                <Content />
            </div>
        </section>

        <!-- Highlights -->
        <section
            class="fade-in-section max-w-2xl mx-auto px-6 py-14"
            style="animation-delay: 0.1s"
        >
            <h2
                class="text-sm font-mono text-stone-500 uppercase tracking-widest mb-8"
            >
                Highlights
            </h2>
            <div class="grid gap-4">
                {
                    site.highlights.map((item) => (
                        <a
                            href={item.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group block border border-stone-300 rounded-lg p-5 hover:border-slate-400 transition-colors bg-stone-200/50"
                        >
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <h3 class="font-medium text-stone-900 group-hover:text-slate-400 transition-colors mb-2">
                                        {item.title}
                                    </h3>
                                    <p class="text-sm text-stone-500 leading-relaxed">
                                        {item.description}
                                    </p>
                                </div>
                                <span class="text-stone-500 group-hover:text-slate-400 transition-colors shrink-0 mt-1">
                                    ↗
                                </span>
                            </div>
                        </a>
                    ))
                }
            </div>
        </section>

        <!-- Footer -->
        <footer class="max-w-2xl mx-auto px-6 py-12 border-t border-stone-300">
            <p class="text-sm text-stone-500 font-mono">
                James Woods &middot; {new Date().getFullYear()}
            </p>
        </footer>
    </div>

    <script>
        import { initTypewriter } from "../scripts/glitch-type";
        import { initFadeIn } from "../scripts/fade-in";

        const el = document.querySelector(".typewriter");
        if (el instanceof HTMLElement) {
            initTypewriter(el);
        }
        initFadeIn();
    </script>
</Base>
